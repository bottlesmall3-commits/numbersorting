import random

def bubble_sort(arr):
    """
    Сортировка списка чисел с помощью алгоритма пузырьковой сортировки
    Алгоритм несколько раз проходит по списку, сравнивает соседние элементы и меняет их местами, если они стоят в неправильном порядке
    После каждого прохода самый большой элемент встает в конец списка, поэтому следующий проход можно делать чуть короче
    """
    n = len(arr)
    # Внешний цикл отвечает за количество полных проходов по массиву

    for i in range(n - 1):
        swapped = False  # Флаг для оптимизации отслеживает, были ли перестановки
        # Внутренний цикл попарно сравнивает элементы
        # С каждым внешним проходом последний элемент уже стоит на своем месте, поэтому его не нужно проверять снова
        for j in range(n - 1 - i):
            if arr[j] > arr[j + 1]:
                # Меняем элементы местами
                arr[j], arr[j + 1] = arr[j + 1], arr[j]
                swapped = True
        # Если за полный проход внутреннего цикла ни одной замены не произошло, значит, массив уже отсортирован, и алгоритм можно завершить досрочно
        if not swapped:
            break

# Генерация списка например из 20 случайных чисел от 1 до 20
numbers = [random.randint(1, 20) for _ in range(20)]

# Или если нужен алгоритм для последовательности чисел от 1 до 20 без повторений:
# numbers = list(range(1, 21)) 
# random.shuffle(numbers)

print("Исходный список:")
print(numbers)

bubble_sort(numbers)

print("Отсортированный список:")
print(numbers)
